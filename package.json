{
  "name": "archival-iiif-server",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "format": "prettier --write \"**/*.ts\"",
    "start": "tsx src/app.ts",
    "start:dev": "nodemon --watch src --ext ts --exec \"tsx src/app.ts\"",
    "start:prod": "node src/app.js"
  },
  "dependencies": {
    "@koa/bodyparser": "^6.1.0",
    "@koa/router": "^15.5.0",
    "axios": "^1.1.3",
    "koa": "^2.13.4",
    "koa-compress": "^5.1.0",
    "lodash": "^4.17.21",
    "mime-types": "^3.0.2",
    "winston": "^3.8.2"
  },
  "devDependencies": {
    "@types/koa": "^2.15.1",
    "@types/koa-compress": "^4.0.3",
    "@types/lodash": "^4.14.189",
    "@types/mime-types": "^2.1.1",
    "@types/node": "^22.15.31",
    "dotenv": "^17.4.2",
    "nodemon": "^3.1.10",
    "tsx": "^4.22.0",
    "typescript": "^5.9.3"
  }
}
